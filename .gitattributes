# Auto detect text files and normalize line endings to LF in the repo
* text=auto eol=lf

# Explicit text files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Windows scripts must remain CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts and gradlew wrapper must always be LF
gradlew text eol=lf
*.sh text eol=lf

# Binary files (do not touch line endings)
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.svg text eol=lf
*.jar binary
*.keystore binary
*.pdf binary
