# Claude CLI — rastrear comandos de automação da equipe, ignorar histórico/sessões locais
.claude/*
!.claude/commands/

# Segredos, chaves e credenciais de integração (NUNCA comitar)
.credentials
*.env
.env
.env*.local
.env.local

# Pastas e arquivos temporários de automação e scripts (trello-fetch, etc.)
.tmp/
*.tmp
.playwright-mcp/

# Dependências Node
node_modules/
npm-debug.*
yarn-debug.*
yarn-error.*

# IDEs: configurações locais de cada máquina (o Android Studio e VS Code recriam)
.idea/
.vscode/
*.iml

# Saídas de build e caches (Android / Gradle / Kotlin)
build/
.gradle/
.kotlin/
.cxx/
.externalNativeBuild/
captures/

# Arquivos locais da máquina (caminho do Android SDK, etc.)
local.properties

# Sistema operacional
.DS_Store
Thumbs.db
